# Copy this file to .env and fill in your own values. .env is ignored by git; never commit it.
# This example holds NO real secrets. Anything marked "your own" must be set on your machine.
# The app does not read .env by itself: load it into your terminal (see README), then start the server.

# --- Calculation date and data source ---------------------------------------------------------
AS_OF_DATE=2026-11-09
# fixture = demo JSON in fixtures/ (no Odoo needed), odoo = read-only from the Odoo database
DATA_SOURCE=fixture

# --- How Odoo is read when DATA_SOURCE=odoo ------------------------------------------------------
# sql = straight into Odoo's PostgreSQL with a read-only role (self-hosted Odoo, see the next block)
# api = through Odoo's API, for hosted Odoo such as Odoo.com that does not expose the database
ODOO_MODE=sql
# Needed for ODOO_MODE=api
ODOO_URL=
# Database name. On Odoo.com it is usually the part of your address before ".odoo.com".
ODOO_DB_NAME=
# Odoo > your profile > Account Security > New API Key. Never commit it.
ODOO_API_KEY=
# The key's Odoo user must have Accounting / Invoicing access rights, or invoices answer "access denied".
# json2 = Odoo 19 and later (default). xmlrpc = older Odoo; it also needs ODOO_API_USER (login of the key's user).
ODOO_API_TRANSPORT=json2
ODOO_API_USER=

# --- Odoo setup account (only used by scripts/seed_odoo.py) -----------------------------------
ODOO_SETUP_USER=
ODOO_SETUP_PASSWORD=

# --- Application database (PostgreSQL): expected outgoings and, later, drafts and users -------
# Create it once with scripts/init_app_db.sql, then run: python scripts/migrate.py
APP_DB_HOST=localhost
# 5432 for a PostgreSQL installed on your machine, 5433 if you run Postgres in Docker
APP_DB_PORT=5432
APP_DB_NAME=thutien_app
APP_DB_USER=thutien_app
# Your own password for APP_DB_USER. Left empty, the app reports "application database unavailable".
APP_DB_PASSWORD=

# --- Auth --------------------------------------------------------------------------------------
# Uncomment and set your own. Do NOT leave them set but empty: an empty value is used as the secret/password.
# Without these lines the code falls back to public demo defaults, fine on your laptop, never on a shared server.
#   JWT_SECRET:    python -c "import secrets; print(secrets.token_urlsafe(48))"
#   DEMO_PASSWORD: password of the demo accounts, at least 8 characters
# JWT_SECRET=
# DEMO_PASSWORD=
