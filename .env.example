AS_OF_DATE=2026-11-09

# Odoo database, read-only account (used by the app; nothing is ever written to Odoo)
ODOO_DB_HOST=localhost
ODOO_DB_PORT=5433
ODOO_DB_NAME=odoo
ODOO_RO_USER=thutien_ro
ODOO_RO_PASSWORD=change-me

# Odoo setup account (only used by scripts/seed_odoo.py)
ODOO_SETUP_USER=
ODOO_SETUP_PASSWORD=

# Application database (users, reminder drafts, tasks, audit log). Create it with scripts/init_app_db.sql
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=thutien_app
APP_DB_USER=thutien_app
APP_DB_PASSWORD=change-me

# Auth. Use a long random JWT_SECRET of your own. DEMO_PASSWORD is only read by scripts/seed_users.py
# (at least 8 characters); it is not a login backdoor.
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
DEMO_PASSWORD=demo12345
