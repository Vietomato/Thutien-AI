# CashPilot configuration. Copy this file to `.env` (ignored by git) and fill in your own values.
# Never commit real passwords or API keys. The backend reads `.env` once at start-up: restart it after any change.
# Format: one NAME=value per line. Comments must be on their own line (not after a value), and values need no quotes.

# ------------------------------------------------------------------------------------------------------------------
# Calculation date
# ------------------------------------------------------------------------------------------------------------------
# "Today" for every prediction and forecast. Fixed so the demo data gives the same numbers every time.
# Use the real current date (YYYY-MM-DD) for live data.
AS_OF_DATE=2026-11-09

# ------------------------------------------------------------------------------------------------------------------
# Odoo data source (read-only: the app never writes to Odoo)
# ------------------------------------------------------------------------------------------------------------------
# local_db = the Odoo PostgreSQL from docker-compose (default)   |   online = Odoo Online over the JSON-2 API
ODOO_SOURCE=local_db

# --- local_db: a read-only role created by scripts/create_readonly_role.sql ---
ODOO_DB_HOST=localhost
# docker-compose maps PostgreSQL to 5433 because 5432 is often taken by a local PostgreSQL
ODOO_DB_PORT=5433
ODOO_DB_NAME=odoo
ODOO_RO_USER=thutien_ro
ODOO_RO_PASSWORD=change-me

# --- online: Odoo 19+ JSON-2 (Custom plan). Use a dedicated user with read access only. ---
# Create the key in Odoo: My Profile > Account Security > New API Key. Paste only the key value.
ODOO_ONLINE_URL=
ODOO_ONLINE_API_KEY=
# Only if the domain does not identify the database by itself
ODOO_ONLINE_DB=
# Only if your database has a technical field holding the dispute state (otherwise "[DISPUTE]" in the invoice narration is used)
ODOO_ONLINE_DISPUTE_FIELD=

# --- Odoo setup account: used only by scripts/seed_odoo.py to load the demo invoices into the local Odoo ---
ODOO_SETUP_USER=
ODOO_SETUP_PASSWORD=

# ------------------------------------------------------------------------------------------------------------------
# Application database (users, reminder drafts, tasks, expected outgoings, audit log)
# Create it with scripts/init_app_db.sql
# ------------------------------------------------------------------------------------------------------------------
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=thutien_app
APP_DB_USER=thutien_app
APP_DB_PASSWORD=change-me
# Optional: a full connection URL replaces the five values above (APP_DB_URL or DATABASE_URL)
# APP_DB_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------------------------------------------------------------
# Login
# ------------------------------------------------------------------------------------------------------------------
# A long random string of your own (at least 32 characters). Signs the login tokens. Backend only.
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
# Password given to the demo accounts by scripts/seed_users.py (at least 8 characters). It is not a login backdoor.
DEMO_PASSWORD=demo12345

# ------------------------------------------------------------------------------------------------------------------
# Chat assistant ("Hỏi trợ lý", accountants and chief accountants only)
# ------------------------------------------------------------------------------------------------------------------
# The model picks read-only tools, the backend computes the numbers, the model explains them. Choose ONE provider.
#   groq   : fast, has a free tier (https://console.groq.com)           -> needs GROQ_API_KEY
#   openai : ChatGPT API (https://platform.openai.com, needs credit)    -> needs OPENAI_API_KEY
#   ollama : a local or LAN model, nothing leaves your network          -> needs OLLAMA_URL (a CPU-only machine is slow)
#   off    : disable the assistant
# Empty = automatic: openai if OPENAI_API_KEY is set, else groq if GROQ_API_KEY is set, else ollama if OLLAMA_ENABLED=1, else off.
# With groq or openai the question and the tool results (customer names, amounts) are sent to that provider.
CHAT_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Only to go through a proxy or a compatible service (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Empty = the provider's default: openai/gpt-oss-120b (groq), gpt-4o-mini (openai), OLLAMA_MODEL (ollama).
# The model must support tool calling.
CHAT_MODEL=
# Seconds to wait for the model (1 to 180). Use 120 or more for a CPU-only Ollama.
CHAT_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------------------------------------------
# Ollama (local LLM). Used by the chat assistant when CHAT_PROVIDER=ollama, and for the wording of reminder drafts.
# ------------------------------------------------------------------------------------------------------------------
# 1 = reminder drafts ask Ollama for two generic sentences (no customer data is sent). 0 = fixed template.
OLLAMA_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Reminder drafts only (1 to 60). The chat assistant uses CHAT_TIMEOUT_SECONDS.
OLLAMA_TIMEOUT_SECONDS=30
