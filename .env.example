AS_OF_DATE=2026-11-09

# ---------------------------------------------------------------------------
# ODOO (read-only for the app; nothing is ever written to Odoo by the backend)
# Pick ONE mode. If ODOO_URL and ODOO_API_KEY are set, mode 1 is used.
# ---------------------------------------------------------------------------
# Mode 1 (recommended): Odoo.com / any Odoo reachable over XML-RPC. No Docker needed for Odoo.
# Create the key in Odoo: My Profile -> Account Security -> New API Key.
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-company
ODOO_EMAIL=your-email@example.com
ODOO_API_KEY=your-odoo-api-key

# Mode 2: direct read-only access to a self-hosted Odoo PostgreSQL (docker compose). Leave mode 1 empty.
ODOO_DB_HOST=localhost
ODOO_DB_PORT=5433
ODOO_DB_NAME=odoo
ODOO_RO_USER=thutien_ro
ODOO_RO_PASSWORD=change-me

# Setup account, only for the seed scripts (scripts/seed_odoo.py, seed_odoo_fast.py, clear_odoo.py).
# In mode 1 they reuse ODOO_EMAIL / ODOO_API_KEY, so these two can stay empty.
ODOO_SETUP_USER=
ODOO_SETUP_PASSWORD=

# ---------------------------------------------------------------------------
# APPLICATION DATABASE (users, reminder drafts, tasks, audit log)
# ---------------------------------------------------------------------------
# Option A: host/port (local Docker or your own server). Create it with scripts/init_app_db.sql
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=thutien_app
APP_DB_USER=thutien_app
APP_DB_PASSWORD=change-me

# Option B: one connection URL (hosted Postgres such as Neon or Supabase). Takes priority over option A.
# APP_DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
# Use a long random JWT_SECRET of your own. DEMO_PASSWORD is only read by scripts/seed_users.py
# (at least 8 characters); it is not a login backdoor.
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
DEMO_PASSWORD=change-me-demo
